[node name="InfoScene" type="CanvasLayer" unique_id=860561683]
script = ExtResource("1_qrouy")
pages = Array[String](["Ang maginoo o datu ay iisa, sila ang pinakamataas na antas sa lipunang Tagalog at Bisaya.", "Nagiging datu ang isang tao dahil sa katapangan, katalinuhan, pagmamana, o kayamanan.", "Nasusukat ang kanilang yaman sa dami ng alipin, ginto, at lupain.", "Ang ginto ay simbolo ng mataas na katayuan, at ginagamit ang “Gat” o “Lakan” bilang tanda ng paggalang sa mga maginoo."])
next_scene = "res://maps/pre_colonial_main_map.tscn"

