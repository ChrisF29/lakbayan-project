[sub_resource type="Shader" id="Shader_countdown"]
code = "shader_type canvas_item;

uniform vec2 hole_center_px = vec2(0.0);
uniform float hole_radius_px = 72.0;
uniform float edge_px = 12.0;

void fragment() {
    vec2 screen_px = SCREEN_UV / SCREEN_PIXEL_SIZE;
    float dist = distance(screen_px, hole_center_px);
    float alpha = smoothstep(hole_radius_px - edge_px, hole_radius_px, dist);
    COLOR = vec4(0.0, 0.0, 0.0, alpha);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_countdown"]
shader = SubResource("Shader_countdown")
shader_parameter/hole_center_px = Vector2(0, 0)
shader_parameter/hole_radius_px = 72.0
shader_parameter/edge_px = 12.0

